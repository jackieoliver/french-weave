{
  "manifest_version": 3,
  "name": "French Weave",
  "version": "0.2.15",
  "description": "Swaps a few English words for French on any website in Chrome or Firefox, at your French Weave level.",
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "french-weave@frenchweave",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["websiteContent"] }
    }
  },
  "permissions": ["storage", "alarms", "nativeMessaging", "scripting", "activeTab"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*", "https://openrouter.ai/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "src/background.js", "scripts": ["src/background.js"], "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/content-loader.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["src/*.js"], "matches": ["http://*/*", "https://*/*"] }
  ],
  "action": { "default_popup": "src/popup.html", "default_title": "French Weave" }
}
