{
  "manifest_version": 3,
  "name": "__MSG_ext_name__",
  "version": "0.12.26",
  "minimum_chrome_version": "140",
  "key": "",
  "description": "__MSG_ext_description__",
  "default_locale": "en",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "commands": {
    "pause-on-this-page": {
      "suggested_key": { "default": "Alt+Shift+W" },
      "description": "__MSG_command_pause__"
    },
    "open-review": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "__MSG_command_review__"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "src/content-loader.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/catalog.js",
        "src/content.js",
        "src/events.js",
        "src/fsrs.js",
        "src/hash.js",
        "src/i18n.js",
        "src/language-name.js",
        "src/learning.js",
        "src/levels.js",
        "src/messages-en.js",
        "src/page.js",
        "src/panel-style.js",
        "src/personal-capture.js",
        "src/personal.js",
        "src/review.js",
        "src/semantic.js",
        "src/settings.js",
        "src/text.js",
        "src/vocabulary.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "__MSG_action_title__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  }
}
