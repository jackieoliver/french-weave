package(default_visibility = ["//visibility:private"])

filegroup(
    name = "fsrs_cases",
    srcs = [
        "fsrs.test.js",
        "fsrs-reference.json",
    ],
    visibility = ["//:__pkg__"],
)

filegroup(
    name = "release_cases",
    # The Guaraní test is contributed by the separate runtime change.
    srcs = glob(
        ["guarani.test.js"],
        allow_empty = True,
    ) + [
        "backup-fixture.js",
        "language-worker.test.js",
        "languages.test.js",
        "portability.test.js",
        "portability-v2.test.js",
        "web-accessible.test.js",
    ],
    visibility = ["//:__pkg__"],
)
