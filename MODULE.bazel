module(
    name = "lang_weave",
    version = "0.12.25",
)

bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "platforms", version = "1.0.0")

bun_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

bun_archive(
    name = "bun_linux_x64",
    build_file = "//build_defs:bun.BUILD.bazel",
    sha256 = "bf8ccbfb2b0b80159e0f9a6d15c55317add8077534dbc6130a3edb52fccb395c",
    strip_prefix = "bun-linux-x64",
    urls = ["https://github.com/oven-sh/bun/releases/download/bun-v1.4.4/bun-linux-x64.zip"],
)

playwright_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

playwright_archive(
    name = "playwright_core",
    build_file_content = """filegroup(
    name = "runtime",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
exports_files(["index.mjs"], visibility = ["//visibility:public"])
""",
    integrity = "sha512-BC4s8y6SEVA6Q1rSxZTto8hI1KUI3xXlHGZgvGqP4IqPdI/a6FX9H29IDNz7vKo9l21b6LfYosScPL6M3xxyDQ==",
    strip_prefix = "package",
    urls = ["https://registry.npmjs.org/playwright-core/-/playwright-core-1.64.1.tgz"],
)
